PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/teamup
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Rate Limiting Settings (Optional - sensible defaults applied if omitted)
# Enable or disable rate limiting globally (useful for development/e2e testing)
RATE_LIMIT_ENABLED=true

# General API rate limiting (applies to /api/* endpoints)
# RATE_LIMIT_MAX=1000                    # Maximum allowed requests per window (alias: RATE_LIMIT_API_MAX)
# RATE_LIMIT_WINDOW_MIN=15               # Window duration in minutes (alias: RATE_LIMIT_API_WINDOW_MIN)
# RATE_LIMIT_WINDOW_MS=900000            # Window duration in ms (optional override over minutes)
# RATE_LIMIT_MESSAGE="Rate limit exceeded. Too many requests, please slow down."

# Strict authentication rate limiting (applies to /api/auth/login and /api/auth/register)
# RATE_LIMIT_AUTH_MAX=20                 # Maximum login/registration attempts per window
# RATE_LIMIT_AUTH_WINDOW_MIN=15          # Auth window duration in minutes
# RATE_LIMIT_AUTH_WINDOW_MS=900000       # Auth window duration in ms (optional override over minutes)
# RATE_LIMIT_AUTH_MESSAGE="Too many login attempts. Please try again later."
